{
  "bsonType": "object",
  "required": ["username", "password"],
  "permission": {
    "read": true,
    "create": true,
    "update": "doc._id == auth.uid",
    "delete": false
  },
  "properties": {
    "_id": {
      "description": "ID，系统自动生成"
    },
    "username": {
      "bsonType": "string",
      "description": "用户名",
      "title": "用户名",
      "trim": "both",
      "minLength": 2
    },
    "password": {
      "bsonType": "string",
      "description": "密码",
      "title": "密码",
      "trim": "both",
      "minLength": 6
    },
    "avatar": {
      "bsonType": "string",
      "description": "头像地址",
      "title": "头像",
      "trim": "both"
    },
    "phone": {
      "bsonType": "string",
      "description": "手机号码",
      "title": "手机号码",
      "pattern": "^1[3-9]\\d{9}$"
    },
    "email": {
      "bsonType": "string",
      "description": "电子邮箱",
      "format": "email",
      "title": "邮箱"
    },
    "status": {
      "bsonType": "int",
      "description": "用户状态：0-禁用 1-正常",
      "minimum": 0,
      "maximum": 1,
      "defaultValue": 1
    },
    "register_date": {
      "bsonType": "timestamp",
      "description": "注册时间",
      "defaultValue": {
        "$env": "now"
      }
    },
    "last_login_date": {
      "bsonType": "timestamp",
      "description": "最后登录时间"
    },
    "role": {
      "bsonType": "string",
      "description": "用户角色：admin-管理员 user-普通用户",
      "enum": ["admin", "user"],
      "defaultValue": "user"
    }
  }
}