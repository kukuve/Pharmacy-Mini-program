{
  "bsonType": "object",
  "required": ["user_id", "name", "phone", "province", "city", "district", "detail"],
  "permission": {
    "read": "doc.user_id == auth.uid",
    "create": "auth.uid != null",
    "update": "doc.user_id == auth.uid",
    "delete": "doc.user_id == auth.uid"
  },
  "properties": {
    "_id": {
      "description": "ID，系统自动生成"
    },
    "user_id": {
      "bsonType": "string",
      "description": "用户ID",
      "foreignKey": "users._id"
    },
    "name": {
      "bsonType": "string",
      "description": "收货人姓名",
      "title": "姓名",
      "trim": "both",
      "minLength": 2
    },
    "phone": {
      "bsonType": "string",
      "description": "收货人电话",
      "title": "电话",
      "pattern": "^1[3-9]\\d{9}$"
    },
    "province": {
      "bsonType": "string",
      "description": "省份",
      "title": "省份"
    },
    "city": {
      "bsonType": "string",
      "description": "城市",
      "title": "城市"
    },
    "district": {
      "bsonType": "string",
      "description": "区/县",
      "title": "区/县"
    },
    "detail": {
      "bsonType": "string",
      "description": "详细地址",
      "title": "详细地址",
      "trim": "both",
      "minLength": 5
    },
    "postal_code": {
      "bsonType": "string",
      "description": "邮政编码",
      "title": "邮编",
      "pattern": "^\\d{6}$"
    },
    "is_default": {
      "bsonType": "bool",
      "description": "是否默认地址",
      "title": "默认地址",
      "defaultValue": false
    },
    "create_date": {
      "bsonType": "timestamp",
      "description": "创建时间",
      "defaultValue": {
        "$env": "now"
      }
    },
    "update_date": {
      "bsonType": "timestamp",
      "description": "更新时间",
      "defaultValue": {
        "$env": "now"
      }
    }
  }
}