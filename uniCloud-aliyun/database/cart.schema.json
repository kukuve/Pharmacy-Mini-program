{
  "bsonType": "object",
  "required": ["user_id", "product_id", "quantity"],
  "permission": {
    "read": "doc.user_id == auth.uid",
    "create": "auth.uid != null",
    "update": "doc.user_id == auth.uid",
    "delete": "doc.user_id == auth.uid"
  },
  "properties": {
    "_id": {
      "description": "ID，系统自动生成"
    },
    "user_id": {
      "bsonType": "string",
      "description": "用户ID",
      "foreignKey": "users._id"
    },
    "product_id": {
      "bsonType": "string",
      "description": "商品ID",
      "foreignKey": "products._id"
    },
    "quantity": {
      "bsonType": "int",
      "description": "商品数量",
      "minimum": 1
    },
    "selected": {
      "bsonType": "bool",
      "description": "是否选中",
      "defaultValue": true
    },
    "product_snapshot": {
      "bsonType": "object",
      "description": "商品快照，保存加入购物车时的商品信息",
      "properties": {
        "name": {
          "bsonType": "string",
          "description": "商品名称"
        },
        "price": {
          "bsonType": "number",
          "description": "商品价格"
        },
        "mainImage": {
          "bsonType": "string",
          "description": "商品主图"
        },
        "spec": {
          "bsonType": "string",
          "description": "商品规格"
        }
      }
    },
    "create_date": {
      "bsonType": "timestamp",
      "description": "创建时间",
      "defaultValue": {
        "$env": "now"
      }
    },
    "update_date": {
      "bsonType": "timestamp",
      "description": "更新时间",
      "defaultValue": {
        "$env": "now"
      }
    }
  }
}